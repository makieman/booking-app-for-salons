<!-- Status -->
<p style="margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#2563EB;">
  ● &nbsp;Appointment Rescheduled
</p>

<!-- Title -->
<h1 style="margin:0 0 8px;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.03em;color:#0F172A;">
  Your appointment has been updated
</h1>

<p style="margin:0 0 28px;font-size:15px;line-height:1.6;color:#475569;">
  Hi {{booking.customerName}}, your booking with <strong style="color:#0F172A;">{{tenant.name}}</strong> has been moved to a new time.
</p>

<!-- Actions: Add to Google Calendar & Reschedule -->
<table cellpadding="0" cellspacing="0" role="presentation" style="margin:0 0 32px;">
  <tr>
    {{#if googleCalendarUrl}}
    <td align="center" style="background-color:#0F172A;border-radius:8px;padding:12px 22px;">
      <a href="{{googleCalendarUrl}}" target="_blank" style="color:#FFFFFF;text-decoration:none;font-size:13px;font-weight:600;letter-spacing:0.01em;display:inline-block;">
        📅 &nbsp;Add New Time to Google Calendar
      </a>
    </td>
    {{/if}}
    {{#if rescheduleUrl}}
    <td style="padding-left:12px;vertical-align:middle;">
      <a href="{{rescheduleUrl}}" target="_blank" style="color:#0F172A;font-size:13px;font-weight:600;text-decoration:none;display:inline-block;padding:11px 16px;background-color:#F1F5F9;border-radius:8px;">
        Pick another slot &rarr;
      </a>
    </td>
    {{/if}}
  </tr>
</table>

<!-- Key Details List (Minimal hairline dividers, NO outer border box) -->
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:28px;">

  <!-- New Date -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#64748B;width:35%;vertical-align:top;">
      New Date
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;font-weight:600;color:#0F172A;vertical-align:top;">
      {{formattedDate}}
    </td>
  </tr>

  <!-- New Time -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#64748B;vertical-align:top;">
      New Time
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;font-weight:600;color:#0F172A;vertical-align:top;">
      {{booking.startTime}} – {{booking.endTime}}
      {{#if durationLabel}}<span style="font-size:12px;font-weight:400;color:#64748B;">({{durationLabel}})</span>{{/if}}
    </td>
  </tr>

  <!-- Service -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#64748B;vertical-align:top;">
      Service
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;font-weight:600;color:#0F172A;vertical-align:top;">
      {{service.name}}
    </td>
  </tr>

  <!-- Stylist -->
  {{#if attendantName}}
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#64748B;vertical-align:top;">
      Stylist
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;font-weight:600;color:#0F172A;vertical-align:top;">
      {{attendantName}}
    </td>
  </tr>
  {{/if}}

  <!-- Reference Code -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#64748B;vertical-align:top;">
      Booking Reference
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;font-family:monospace;font-weight:700;color:#0F172A;vertical-align:top;">
      #{{booking.reference}}
    </td>
  </tr>

  <!-- Total Price -->
  <tr>
    <td style="padding:14px 0 8px;font-size:14px;font-weight:600;color:#0F172A;vertical-align:top;">
      Total
    </td>
    <td align="right" style="padding:14px 0 8px;font-size:16px;font-weight:700;color:#0F172A;vertical-align:top;">
      {{formattedPrice}}
    </td>
  </tr>

</table>

<!-- Reschedule & Changes Section -->
<div style="margin:28px 0 0;padding-top:20px;border-top:1px solid #F1F5F9;">
  <p style="margin:0 0 6px;font-size:13px;font-weight:600;color:#0F172A;">
    Need a different date or time?
  </p>
  <p style="margin:0 0 16px;font-size:13px;color:#475569;line-height:1.6;">
    If this new time does not suit your schedule, you can easily <a href="{{rescheduleUrl}}" target="_blank" style="color:#0F172A;font-weight:600;text-decoration:underline;">choose another slot online &rarr;</a>
  </p>

  <p style="margin:0;font-size:12px;color:#64748B;line-height:1.6;">
    Questions?
    {{#if whatsAppUrl}}
      <a href="{{whatsAppUrl}}" target="_blank" style="color:#0F172A;font-weight:500;text-decoration:underline;">Chat on WhatsApp</a>{{#if tenant.supportPhone}} or{{/if}}
    {{/if}}
    {{#if tenant.supportPhone}}
      call <a href="tel:{{tenant.supportPhone}}" style="color:#0F172A;font-weight:500;text-decoration:underline;">{{tenant.supportPhone}}</a>.
    {{/if}}
    {{#if bookingViewUrl}}
      <span style="display:block;margin-top:6px;">
        <a href="{{bookingViewUrl}}" target="_blank" style="color:#64748B;text-decoration:none;">View booking status online &rarr;</a>
      </span>
    {{/if}}
  </p>
</div>
