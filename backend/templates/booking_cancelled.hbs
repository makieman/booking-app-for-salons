<!-- Status -->
<p style="margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#DC2626;">
  ● &nbsp;Booking Cancelled
</p>

<!-- Title -->
<h1 style="margin:0 0 8px;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.03em;color:#0F172A;">
  Your booking has been cancelled
</h1>

<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#475569;">
  Hi {{booking.customerName}}, your booking for <strong style="color:#0F172A;">{{service.name}}</strong> with <strong style="color:#0F172A;">{{tenant.name}}</strong> has been cancelled.
</p>

{{#if reason}}
<p style="margin:0 0 24px;font-size:14px;color:#991B1B;line-height:1.6;">
  <strong>Reason:</strong> {{reason}}
</p>
{{/if}}

<!-- Action: Book New Slot -->
{{#if salonUrl}}
<table cellpadding="0" cellspacing="0" role="presentation" style="margin:0 0 32px;">
  <tr>
    <td align="center" style="background-color:#0F172A;border-radius:8px;padding:12px 22px;">
      <a href="{{salonUrl}}" target="_blank" style="color:#FFFFFF;text-decoration:none;font-size:13px;font-weight:600;letter-spacing:0.01em;display:inline-block;">
        Book a New Appointment &rarr;
      </a>
    </td>
  </tr>
</table>
{{/if}}

<!-- Key Details List (Minimal hairline dividers, NO outer border box) -->
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:28px;">

  <!-- Cancelled Date -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#94A3B8;width:35%;vertical-align:top;">
      Original Date
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;color:#94A3B8;text-decoration:line-through;vertical-align:top;">
      {{formattedDate}}
    </td>
  </tr>

  <!-- Cancelled Time -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#94A3B8;vertical-align:top;">
      Original Time
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;color:#94A3B8;text-decoration:line-through;vertical-align:top;">
      {{booking.startTime}} – {{booking.endTime}}
    </td>
  </tr>

  <!-- Service -->
  <tr>
    <td style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:13px;color:#64748B;vertical-align:top;">
      Service
    </td>
    <td align="right" style="padding:12px 0;border-bottom:1px solid #F1F5F9;font-size:14px;font-weight:600;color:#0F172A;vertical-align:top;">
      {{service.name}}
    </td>
  </tr>

  <!-- Reference Code -->
  <tr>
    <td style="padding:12px 0;font-size:13px;color:#64748B;vertical-align:top;">
      Booking Reference
    </td>
    <td align="right" style="padding:12px 0;font-size:13px;font-family:monospace;font-weight:600;color:#64748B;vertical-align:top;">
      #{{booking.reference}}
    </td>
  </tr>

</table>

<p style="margin:0;font-size:13px;color:#64748B;line-height:1.6;">
  If you have questions or wish to rebook directly,
  {{#if whatsAppUrl}}
    <a href="{{whatsAppUrl}}" target="_blank" style="color:#0F172A;font-weight:600;text-decoration:underline;">chat with us on WhatsApp</a> or
  {{/if}}
  {{#if tenant.supportPhone}}
    call <a href="tel:{{tenant.supportPhone}}" style="color:#0F172A;font-weight:600;text-decoration:underline;">{{tenant.supportPhone}}</a>.
  {{/if}}
</p>
