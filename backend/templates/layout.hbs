<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{#if tenant.name}}{{tenant.name}}{{else}}Salon Booking{{/if}}</title>
  <!--[if mso]>
  <style>
    body, table, td, p, a, h1, h2, h3 { font-family: Arial, sans-serif !important; }
  </style>
  <![endif]-->
  <style type="text/css">
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 16px 12px !important;
      }
      .email-content {
        width: 100% !important;
        max-width: 100% !important;
      }
      .email-cell {
        padding: 20px 0 !important;
      }
    }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#FFFFFF;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:#111827;line-height:1.5;">

  {{#if previewText}}
  <div style="display:none;font-size:1px;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;mso-hide:all;font-family:sans-serif;">
    {{previewText}} &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
  </div>
  {{/if}}

  <!-- Full width outer table -->
  <table class="email-wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#FFFFFF;margin:0;padding:40px 16px 56px;">
    <tr>
      <td align="center" style="padding:0;">

        <!-- Main centered container: clean, borderless, airy -->
        <table class="email-content" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:520px;margin:0 auto;text-align:left;">

          <!-- Minimal Header -->
          <tr>
            <td style="padding:0 0 24px;border-bottom:1px solid #F1F5F9;">
              <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <td align="left" style="vertical-align:middle;">
                    {{#if tenant.branding.logoUrl}}
                      <img src="{{tenant.branding.logoUrl}}" alt="{{tenant.name}}" style="max-height:36px;max-width:160px;height:auto;display:block;border:0;object-fit:contain;margin-bottom:6px;" />
                    {{/if}}
                    <span style="font-size:17px;font-weight:700;letter-spacing:-0.02em;color:#111827;">
                      {{tenant.name}}
                    </span>
                  </td>
                  {{#if tenant.slug}}
                  <td align="right" style="vertical-align:middle;">
                    <a href="{{salonUrl}}" target="_blank" style="font-size:12px;font-weight:500;color:#64748B;text-decoration:none;">
                      Visit Salon &rarr;
                    </a>
                  </td>
                  {{/if}}
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body Content -->
          <tr>
            <td class="email-cell" style="padding:32px 0 40px;">
              {{{body}}}
            </td>
          </tr>

          <!-- Minimal Footer -->
          <tr>
            <td style="padding:28px 0 0;border-top:1px solid #F1F5F9;font-size:12px;color:#64748B;line-height:1.6;">
              <p style="margin:0 0 6px;color:#334155;font-weight:600;">
                {{tenant.name}}
              </p>

              <p style="margin:0 0 16px;color:#64748B;">
                {{#if tenant.supportPhone}}
                  Phone: <a href="tel:{{tenant.supportPhone}}" style="color:#334155;text-decoration:none;font-weight:500;">{{tenant.supportPhone}}</a>
                  {{#if whatsAppUrl}} &bull; <a href="{{whatsAppUrl}}" target="_blank" style="color:#16A34A;text-decoration:none;font-weight:500;">WhatsApp</a>{{/if}}
                {{/if}}
                {{#if tenant.supportEmail}}
                  {{#if tenant.supportPhone}} &bull; {{/if}}
                  <a href="mailto:{{tenant.supportEmail}}" style="color:#334155;text-decoration:none;font-weight:500;">{{tenant.supportEmail}}</a>
                {{/if}}
              </p>

              <p style="margin:0;font-size:11px;color:#94A3B8;">
                Automated booking notice from {{tenant.name}}. If you need to reschedule or have questions, contact us directly.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
