MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flo-sisterlocks
PORT=5000
NODE_ENV=development

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Who receives new-booking alerts — comma-separated for multiple admins
ADMIN_EMAIL=flo@yoursalon.com,secondadmin@yoursalon.com

# The "From" address for outgoing emails.
# For testing use: onboarding@resend.dev (Resend sandbox)
# For production: verify your domain at resend.com → Domains
FROM_EMAIL=onboarding@resend.dev

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# MUST be a mailto: URI (e.g. mailto:admin@example.com)
VAPID_MAILTO=mailto:admin@example.com

# ── Auth (Staff Accounts) ─────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# Owner (super-admin) PIN — overrides the hardcoded '1234' default
# Change this before going live!
OWNER_PIN=1234

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# Get your credentials at developer.facebook.com → WhatsApp settings
WHATSAPP_TOKEN=EAAB_your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# Optional (defaults to v21.0 if omitted)
WHATSAPP_API_VERSION=v21.0

# ── WhatsApp Inbound Webhook ──────────────────────────────────────────────────
# A secret string YOU choose — paste the same value into:
#   developers.facebook.com → Your App → WhatsApp → Configuration → Verify Token
WHATSAPP_WEBHOOK_TOKEN=replace_with_your_own_secret_string

# Found at: App Settings → Basic → App Secret  (NOT the access token)
# Used to verify the X-Hub-Signature-256 header on inbound POST requests.
WHATSAPP_APP_SECRET=replace_with_meta_app_secret

# Per-tenant setup: after setting the vars above, store each tenant's
# numeric phone_number_id directly on the Tenant document in MongoDB:
#   db.tenants.updateOne({ slug: 'your-salon' }, { $set: { whatsappPhoneNumberId: '106540352242922' } })
# The webhook uses this field to resolve which tenant an inbound message belongs to.

# ── Development Seeding ───────────────────────────────────────────────────────
# Set to 'true' to seed an example attendant (flo / 1234) on first startup
SEED_ATTENDANTS=false
