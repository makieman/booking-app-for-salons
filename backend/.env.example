MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flo-sisterlocks
PORT=5000
NODE_ENV=development

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Who receives new-booking alerts — comma-separated for multiple admins
ADMIN_EMAIL=flo@yoursalon.com,secondadmin@yoursalon.com

# The "From" address for outgoing emails.
# IMPORTANT: In Resend, the sandbox address "onboarding@resend.dev" can ONLY send
# emails to the account owner's registered email address. Customer confirmation
# emails will NOT be delivered until you add and verify your custom domain in Resend
# (https://resend.com/domains) and set FROM_EMAIL to an address on that domain.
# Testing default: onboarding@resend.dev
# Production required: bookings@yourdomain.com
FROM_EMAIL=bookings@yourdomain.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# MUST be a mailto: URI (e.g. mailto:admin@example.com)
VAPID_MAILTO=mailto:admin@example.com

# ── Auth (Staff Accounts) ─────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string


# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# Get your credentials at developer.facebook.com → WhatsApp settings
WHATSAPP_TOKEN=EAAB_your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# Optional (defaults to v21.0 if omitted)
WHATSAPP_API_VERSION=v21.0

# ── WhatsApp Inbound Webhook ──────────────────────────────────────────────────
# A secret string YOU choose — paste the same value into:
#   developers.facebook.com → Your App → WhatsApp → Configuration → Verify Token
WHATSAPP_WEBHOOK_TOKEN=replace_with_your_own_secret_string

# Found at: App Settings → Basic → App Secret  (NOT the access token)
# Used to verify the X-Hub-Signature-256 header on inbound POST requests.
WHATSAPP_APP_SECRET=replace_with_meta_app_secret

# Per-tenant setup: after setting the vars above, store each tenant's
# numeric phone_number_id directly on the Tenant document in MongoDB:
#   db.tenants.updateOne({ slug: 'your-salon' }, { $set: { whatsappPhoneNumberId: '106540352242922' } })
# The webhook uses this field to resolve which tenant an inbound message belongs to.

# ── Media Uploads (Cloudinary) ────────────────────────────────────────────────
# Get credentials at https://cloudinary.com/console
# Either provide the full CLOUDINARY_URL connection string:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or specify individual credentials:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Development Seeding ───────────────────────────────────────────────────────
# Set to 'true' to seed the default demo tenant on first startup when database is empty
SEED_DEFAULT_TENANT=false
# Set to 'true' to seed an example attendant (flo / 1234) on first startup
SEED_ATTENDANTS=false

# ── SMS (optional) ───────────────────────────────────────────────────────────
# Leave SMS_PROVIDER empty to keep SMS off. Each salon also has its own on/off switch in Settings.
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox            # use your Africa's Talking app username in production
AT_API_KEY=
# Optional: leave empty to send WITHOUT a sender ID (salon name is placed at the start of each message).
# Set it only after the provider has approved your sender ID.
SMS_SENDER_ID=
# Spend protection (rolling 24 hours)
SMS_MAX_PER_PHONE_PER_DAY=8
SMS_MAX_PER_TENANT_PER_DAY=300

# ── SMS credits (prepaid) ────────────────────────────────────────────────────
# 1 credit = 1 SMS. Every salon gets this many free credits once, then must be topped up.
SMS_STARTER_CREDITS=20
# Balance at or below this shows a "running low" warning in the salon's Settings.
SMS_LOW_BALANCE=10
# Shown to salon owners as who to contact/pay to top up (e.g. a phone number).
SMS_TOPUP_CONTACT=
# Secret for the platform-operator API (granting credits). Leave EMPTY to keep that API disabled.
# Use 24+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PLATFORM_ADMIN_KEY=

